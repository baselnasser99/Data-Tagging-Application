# Copy this file to .env and fill in real values. Never commit .env.

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Database. Leave unset to use a local SQLite file (database.db).
# DATABASE_URL=mysql+pymysql://tagging:tagging-password@localhost:3306/tagging_db

# First administrator account, created on startup if no admin exists yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Administrator

# Set to true when the site is served over HTTPS.
SESSION_COOKIE_SECURE=false
# Log users out after this many minutes of inactivity.
SESSION_IDLE_MINUTES=60

# Used by docker-compose for the MySQL container.
MYSQL_DATABASE=tagging_db
MYSQL_USER=tagging
MYSQL_PASSWORD=tagging-password
MYSQL_ROOT_PASSWORD=change-me-too
