# Copy this file to .env and fill in real values. Never commit .env.

# Name shown in the browser tab, header and sign-in page.
APP_NAME=Data Tagging

# Long random string (at least 32 characters; example values are refused). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Left empty, a random key is used and everyone is logged out on every restart.
SECRET_KEY=

# Database. Leave unset to use a local SQLite file (database.db).
# DATABASE_URL=mysql+pymysql://tagging:<password>@localhost:3306/tagging_db

# First administrator account, created on startup if no admin exists yet.
# The password needs at least 8 characters. Empty it again once the administrator exists:
# the app (and `docker inspect` of its container) can read every value in this file.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Cookies go over HTTPS only (plain http too on the debug server, flask run --debug).
# Set false only to try the app over plain http without --debug.
# SESSION_COOKIE_SECURE=true
# Reverse proxies in front of the app whose X-Forwarded-For/-Proto headers are trusted.
# docker-compose uses 1; keep 0 when browsers connect to the app directly. Behind a proxy it must
# be set: sign-in limits count per address, and otherwise every visitor has the proxy's address.
# TRUSTED_PROXIES=0
# Log users out after this many minutes of inactivity.
SESSION_IDLE_MINUTES=60

# Largest upload (ZIPs, CSV, question files), for admins and managers on the upload pages only;
# every other request may send at most MAX_REQUEST_MB.
# MAX_UPLOAD_MB=512
# Most item files one project may keep, in MB (0 for no limit).
# MAX_PROJECT_STORAGE_MB=2048
# MAX_REQUEST_MB=2

# Used by docker-compose for the MySQL container.
MYSQL_DATABASE=tagging_db
MYSQL_USER=tagging
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
